+package android.app;
+
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.os.Bundle;
+import android.view.ContextThemeWrapper;
+import android.view.Menu;
+import android.view.MenuItem;
+import android.view.View;
+import android.view.ViewGroup;
+import org.chunkybacon.sim.Device;
+import org.chunkybacon.sim.Json;
+import org.chunkybacon.sim.SimMenu;
+
+/**
+ * android.app.Activity (stand-in, chunkybacon Ruboto lesson). The lifecycle
+ * methods do what Activity's do for an app that does not override them;
+ * the simulated phone (ruboto_sim.rb) calls them in Android's order.
+ */
+public class Activity extends ContextThemeWrapper {
+    public static final int RESULT_OK = -1;
+    public static final int RESULT_CANCELED = 0;
+
+    private CharSequence title = null;
+    private View content;
+    private Intent intent = new Intent();
+    private boolean finishing = false;
+    private String state = "new";
+    private SimMenu menu = null;
+    private boolean menuDirty = true;
+    private boolean superCalled = false;
+
+    public Activity() {}
+
+    private void lifecycle(String s) { state = s; superCalled = true; }
+
+    public void onCreate(Bundle savedInstanceState) { lifecycle("created"); }
+    public void onStart() { lifecycle("started"); }
+    public void onRestart() { superCalled = true; }
+    public void onResume() { lifecycle("resumed"); }
+    public void onPause() { lifecycle("paused"); }
+    public void onStop() { lifecycle("stopped"); }
+    public void onDestroy() { lifecycle("destroyed"); }
+    public void onSaveInstanceState(Bundle outState) { superCalled = true; }
+    public void onRestoreInstanceState(Bundle savedInstanceState) { superCalled = true; }
+    public void onBackPressed() { finish(); }
+    public boolean onCreateOptionsMenu(Menu menu) { return true; }
+    public boolean onPrepareOptionsMenu(Menu menu) { return true; }
+    public boolean onOptionsItemSelected(MenuItem item) { return false; }
+
+    /** Android throws SuperNotCalledException when an override of onCreate (and friends) does not call super */
+    public boolean simTakeSuperCalled() { boolean called = superCalled; superCalled = false; return called; }
+    public String simState() { return state; }
+    public void simState(String s) { state = s; }
+
+    public void setContentView(View view) {
+        if (view.getLayoutParams() == null) {
+            view.setLayoutParams(new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        }
+        content = view;
+    }
+    public void setContentView(int layoutResID) {
+        throw new UnsupportedOperationException("XML layouts (res/layout) are not part of the simulated phone: build the views in Ruby");
+    }
+    public View simContentView() { return content; }
+    public View findViewById(int id) { return content == null ? null : content.findViewById(id); }
+
+    public void setTitle(CharSequence title) { this.title = title; }
+    public CharSequence getTitle() { return title; }
+
+    public Intent getIntent() { return intent; }
+    public void setIntent(Intent intent) { this.intent = intent; }
+
+    public void finish() { finishing = true; Device.finish(this); }
+    public boolean isFinishing() { return finishing; }
+    public boolean isDestroyed() { return "destroyed".equals(state); }
+
+    public void runOnUiThread(Runnable action) { action.run(); }
+    public SharedPreferences getPreferences(int mode) { return getSharedPreferences(getLocalClassName(), mode); }
+    public String getLocalClassName() { return getClass().getSimpleName(); }
+
+    public void invalidateOptionsMenu() { menuDirty = true; }
+    public boolean simMenuDirty() { return menuDirty; }
+    public Menu simNewMenu() { menu = new SimMenu(); menuDirty = false; return menu; }
+    public Menu simMenu() { return menu; }
+
+    public void describe(Json j) {
+        j.put("title", title == null ? null : title.toString()).put("state", state);
+        j.put("dialogTheme", getThemeResId() == android.R.style.Theme_Dialog);
+        if (menu != null && menu.size() > 0) { j.key("menu"); org.chunkybacon.sim.Device.describeMenu(menu, j); }
+        if (content != null) { j.key("content").open('{'); content.describe(j); j.close('}'); }
+    }
+}
diff --git a/android-src/android/app/AlertDialog.java b/android-src/android/app/AlertDialog.java
new file mode 100644
index 0000000..cb61069
--- /dev/null
+++ b/android-src/android/app/AlertDialog.java
@@ -0,0 +1,71 @@
+package android.app;
+
+import android.content.Context;
+import android.content.DialogInterface;
+import android.view.View;
+import org.chunkybacon.sim.Json;
+
+/** android.app.AlertDialog (stand-in): title, message, a list of items or a view, up to three buttons. */
+public class AlertDialog extends Dialog {
+    private CharSequence message;
+    private final CharSequence[] buttonText = new CharSequence[3];
+    private final DialogInterface.OnClickListener[] buttonListener = new DialogInterface.OnClickListener[3];
+    private CharSequence[] items;
+    private DialogInterface.OnClickListener itemsListener;
+    private View view;
+
+    protected AlertDialog(Context context) { super(context); }
+
+    public void setMessage(CharSequence message) { this.message = message; }
+    public void setView(View view) { this.view = view; }
+    @Override public View simView() { return view; }
+
+    public void setButton(int which, CharSequence text, DialogInterface.OnClickListener listener) {
+        int i = -which - 1;
+        buttonText[i] = text;
+        buttonListener[i] = listener;
+    }
+
+    /** the simulated finger: +which+ a BUTTON_* constant, or an item's index */
+    public void simClick(int which) {
+        DialogInterface.OnClickListener l = which >= 0 ? itemsListener : buttonListener[-which - 1];
+        dismiss();
+        if (l != null) l.onClick(this, which);
+    }
+
+    @Override public void describe(Json j) {
+        super.describe(j);
+        if (message != null) j.put("message", message.toString());
+        if (items != null) {
+            j.key("items").open('[');
+            for (CharSequence s : items) j.value(String.valueOf(s));
+            j.close(']');
+        }
+        if (view != null) { j.key("view").open('{'); view.describe(j); j.close('}'); }
+        j.key("buttons").open('[');
+        // Android's order on screen: neutral on the left, then negative, positive
+        int[] order = { DialogInterface.BUTTON_NEUTRAL, DialogInterface.BUTTON_NEGATIVE, DialogInterface.BUTTON_POSITIVE };
+        for (int which : order) {
+            CharSequence t = buttonText[-which - 1];
+            if (t != null) j.item().open('{').put("which", which).put("text", t.toString()).close('}');
+        }
+        j.close(']');
+    }
+
+    public static class Builder {
+        private final AlertDialog dialog;
+
+        public Builder(Context context) { dialog = new AlertDialog(context); }
+
+        public Builder setTitle(CharSequence title) { dialog.setTitle(title); return this; }
+        public Builder setMessage(CharSequence message) { dialog.setMessage(message); return this; }
+        public Builder setView(View view) { dialog.setView(view); return this; }
+        public Builder setCancelable(boolean cancelable) { dialog.setCancelable(cancelable); return this; }
+        public Builder setPositiveButton(CharSequence text, DialogInterface.OnClickListener l) { dialog.setButton(DialogInterface.BUTTON_POSITIVE, text, l); return this; }
+        public Builder setNegativeButton(CharSequence text, DialogInterface.OnClickListener l) { dialog.setButton(DialogInterface.BUTTON_NEGATIVE, text, l); return this; }
+        public Builder setNeutralButton(CharSequence text, DialogInterface.OnClickListener l) { dialog.setButton(DialogInterface.BUTTON_NEUTRAL, text, l); return this; }
+        public Builder setItems(CharSequence[] items, DialogInterface.OnClickListener l) { dialog.items = items; dialog.itemsListener = l; return this; }
+        public AlertDialog create() { return dialog; }
+        public AlertDialog show() { dialog.show(); return dialog; }
+    }
+}
