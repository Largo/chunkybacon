new file mode 100644
index 0000000..79768f6
--- /dev/null
+++ b/android-src/android/widget/AdapterView.java
@@ -0,0 +1,75 @@
+package android.widget;
+
+import android.content.Context;
+import android.view.View;
+import android.view.ViewGroup;
+import org.chunkybacon.sim.Json;
+
+/** android.widget.AdapterView (stand-in): items from an Adapter. */
+public abstract class AdapterView<T extends Adapter> extends ViewGroup {
+    public static final int INVALID_POSITION = -1;
+
+    public interface OnItemClickListener {
+        void onItemClick(AdapterView<?> parent, View view, int position, long id);
+    }
+    public interface OnItemLongClickListener {
+        boolean onItemLongClick(AdapterView<?> parent, View view, int position, long id);
+    }
+    public interface OnItemSelectedListener {
+        void onItemSelected(AdapterView<?> parent, View view, int position, long id);
+        void onNothingSelected(AdapterView<?> parent);
+    }
+
+    private OnItemClickListener onItemClick;
+    private OnItemSelectedListener onItemSelected;
+    int selected = INVALID_POSITION;
+
+    public AdapterView(Context context) { super(context); }
+
+    public abstract T getAdapter();
+    public abstract void setAdapter(T adapter);
+
+    public void setOnItemClickListener(OnItemClickListener l) { onItemClick = l; }
+    public OnItemClickListener getOnItemClickListener() { return onItemClick; }
+    public void setOnItemSelectedListener(OnItemSelectedListener l) { onItemSelected = l; }
+    public OnItemSelectedListener getOnItemSelectedListener() { return onItemSelected; }
+
+    public int getCount() { T a = getAdapter(); return a == null ? 0 : a.getCount(); }
+    public Object getItemAtPosition(int position) { T a = getAdapter(); return a == null || position < 0 ? null : a.getItem(position); }
+    public long getItemIdAtPosition(int position) { T a = getAdapter(); return a == null || position < 0 ? -1 : a.getItemId(position); }
+    public int getSelectedItemPosition() { return selected; }
+    public Object getSelectedItem() { return getItemAtPosition(selected); }
+    public long getSelectedItemId() { return getItemIdAtPosition(selected); }
+
+    public void setSelection(int position) {
+        if (position == selected) return;
+        selected = position;
+        if (onItemSelected != null) onItemSelected.onItemSelected(this, row(position), position, getItemIdAtPosition(position));
+    }
+
+    /** the row's view, as an adapter's simple_list_item_1 makes it */
+    View row(int position) {
+        TextView row = new TextView(getContext());
+        Object item = getItemAtPosition(position);
+        row.setText(String.valueOf(item));
+        return row;
+    }
+
+    /** the simulated finger taps row +position+ */
+    public boolean simItemClick(int position) {
+        if (position < 0 || position >= getCount()) return false;
+        if (onItemClick == null) return false;
+        onItemClick.onItemClick(this, row(position), position, getItemIdAtPosition(position));
+        return true;
+    }
+
+    @Override public void describe(Json j) {
+        super.describe(j);
+        j.key("items").open('[');
+        int n = getCount();
+        for (int i = 0; i < n && i < 500; i++) j.value(String.valueOf(getItemAtPosition(i)));
+        j.close(']');
+        if (selected != INVALID_POSITION) j.put("selected", selected);
+        if (onItemClick != null) j.put("itemClickable", true);
+    }
+}
