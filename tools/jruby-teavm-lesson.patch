+package android.widget;
+
+import android.content.Context;
+import org.chunkybacon.sim.Device;
+
+/** android.widget.Toast (stand-in): the page's phone shows it for 2 s (LENGTH_SHORT) or 3.5 s. */
+public class Toast {
+    public static final int LENGTH_SHORT = 0;
+    public static final int LENGTH_LONG = 1;
+
+    private CharSequence text;
+    private int duration;
+
+    public Toast(Context context) {}
+
+    public static Toast makeText(Context context, CharSequence text, int duration) {
+        Toast t = new Toast(context);
+        t.text = text;
+        t.duration = duration;
+        return t;
+    }
+
+    public void show() { Device.toast(this); }
+    public void cancel() {}
+    public void setText(CharSequence text) { this.text = text; }
+    public CharSequence getText() { return text; }
+    public void setDuration(int duration) { this.duration = duration; }
+    public int getDuration() { return duration; }
+}
diff --git a/android-src/org/chunkybacon/sim/Device.java b/android-src/org/chunkybacon/sim/Device.java
new file mode 100644
index 0000000..49cd309
--- /dev/null
+++ b/android-src/org/chunkybacon/sim/Device.java
@@ -0,0 +1,217 @@
+package org.chunkybacon.sim;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.view.View;
+import android.widget.Toast;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The simulated phone that the Android stand-ins of the chunkybacon Ruboto
+ * lesson live on: a virtual clock, logcat, the toasts and dialogs on screen,
+ * the Handler queue, the intents an activity started, SharedPreferences.
+ *
+ * The activity stack and the lifecycle are driven from Ruby (ruboto_sim.rb):
+ * the Ruby methods of an activity (onCreate, ...) can only be called from
+ * Ruby in this build (no bytecode generation, so Java cannot dispatch to a
+ * Ruby override). Everything Java can do on its own - views, listeners,
+ * timers - happens here.
+ */
+public final class Device {
+    private Device() {}
+
+    public static final int PORTRAIT = 1;
+    public static final int LANDSCAPE = 2;
+
+    static long clock = 0;
+    static int nextSimId = 1;
+    static final Map<Integer, View> views = new HashMap<>();
+    static final List<String[]> log = new ArrayList<>();
+    static int logShown = 0;
+    static final List<String[]> toasts = new ArrayList<>();
+    static int toastsShown = 0;
+    static final List<Intent> started = new ArrayList<>();
+    static final List<Activity> finishing = new ArrayList<>();
+    static final List<Timer> timers = new ArrayList<>();
+    static long timerSeq = 0;
+    static int orientation = PORTRAIT;
+    static final Map<String, SimPreferences> prefs = new HashMap<>();
+    public static Dialog dialog = null;
+
+    static final class Timer {
+        final long due;
+        final long seq;
+        final Runnable task;
+        final Object owner;
+        Timer(long due, long seq, Runnable task, Object owner) { this.due = due; this.seq = seq; this.task = task; this.owner = owner; }
+    }
+
+    // ---- views ----
+
+    public static int register(View view) {
+        int id = nextSimId++;
+        views.put(id, view);
+        return id;
+    }
+
+    public static View view(int simId) { return views.get(simId); }
+
+    // ---- the clock and the Handler queue ----
+
+    public static long now() { return clock; }
+
+    public static void post(Runnable task, long delay, Object owner) {
+        timers.add(new Timer(clock + Math.max(0, delay), timerSeq++, task, owner));
+    }
+
+    public static void cancel(Runnable task, Object owner) {
+        timers.removeIf(t -> (task == null || t.task == task) && (owner == null || t.owner == owner));
+    }
+
+    /** ms until the next posted Runnable is due, -1 when none is */
+    public static long nextTimer() {
+        long next = -1;
+        for (Timer t : timers) if (next < 0 || t.due < next) next = t.due;
+        return next < 0 ? -1 : Math.max(0, next - clock);
+    }
+
+    /** The due Runnable that runs next (removed from the queue), or null; the clock moves to its time. */
+    public static Runnable takeDue(long until) {
+        Timer best = null;
+        for (Timer t : timers) {
+            if (t.due <= until && (best == null || t.due < best.due || (t.due == best.due && t.seq < best.seq))) best = t;
+        }
+        if (best == null) return null;
+        timers.remove(best);
+        if (best.due > clock) clock = best.due;
+        return best.task;
+    }
+
+    public static void advanceTo(long until) { if (until > clock) clock = until; }
+
+    public static int pendingTimers() { return timers.size(); }
+
+    // ---- logcat ----
+
+    public static void log(String level, String tag, String message) {
+        log.add(new String[] { level, String.valueOf(tag), String.valueOf(message), Long.toString(clock) });
+        if (log.size() > 2000) { log.remove(0); if (logShown > 0) logShown--; }
+    }
+
+    /** an app installed anew starts with an empty log (the page shows one log per app) */
+    public static void clearLog() { log.clear(); logShown = 0; }
+
+    public static List<String> logLines() {
+        List<String> lines = new ArrayList<>();
+        for (String[] e : log) lines.add(e[0] + "/" + e[1] + ": " + e[2]);
+        return lines;
+    }
+
+    // ---- toasts ----
+
+    public static void toast(Toast toast) {
+        toasts.add(new String[] { String.valueOf(toast.getText()), Integer.toString(toast.getDuration()) });
+    }
+
+    public static List<String> toastTexts() {
+        List<String> list = new ArrayList<>();
+        for (String[] t : toasts) list.add(t[0]);
+        return list;
+    }
+
+    // ---- activities (Ruby takes these and runs the lifecycle) ----
+
+    public static void startActivity(Intent intent) { started.add(intent); }
+
+    public static Intent takeStarted() { return started.isEmpty() ? null : started.remove(0); }
+
+    public static void finish(Activity activity) { if (!finishing.contains(activity)) finishing.add(activity); }
+
+    public static Activity takeFinishing() { return finishing.isEmpty() ? null : finishing.remove(0); }
+
+    public static int getOrientation() { return orientation; }
+    public static void setOrientation(int o) { orientation = o; }
+
+    public static SharedPreferences preferences(String name) {
+        return prefs.computeIfAbsent(name, k -> new SimPreferences());
+    }
+
+    public static void clearPreferences() { prefs.clear(); }
+
+    /** A new app: no views, timers, toasts, dialogs or intents of the old one. The log and the preferences stay. */
+    public static void reset() {
+        views.clear();
+        timers.clear();
+        toasts.clear();
+        toastsShown = 0;
+        started.clear();
+        finishing.clear();
+        dialog = null;
+    }
+
+    /** Everything, as on a fresh page: the clock, the log and the preferences too. */
+    public static void wipe() {
+        reset();
+        log.clear();
+        logShown = 0;
+        prefs.clear();
+        clock = 0;
+        orientation = PORTRAIT;
+    }
+
+    public static void describeMenu(android.view.Menu menu, Json j) { ((SimMenu) menu).describe(j); }
+
+    // ---- the snapshot the page draws ----
+
+    /**
+     * The screen as JSON: +top+ the activity on top (null: the home screen),
+     * +label+ the app's name, +crash+ a crash message (or null). Log lines
+     * and toasts since the last snapshot go along (+all+: every one).
+     */
+    public static String snapshot(Activity top, String label, String crash, boolean all) {
+        return snapshot(top, label, crash, all, true);
+    }
+
+    /** the same, without marking the log lines and toasts as shown: what a test reads */
+    public static String peek(Activity top, String label, String crash) {
+        return snapshot(top, label, crash, true, false);
+    }
+
+    private static String snapshot(Activity top, String label, String crash, boolean all, boolean consume) {
+        Json j = new Json().open('{');
+        j.put("clock", clock).put("orientation", orientation == LANDSCAPE ? "landscape" : "portrait");
+        j.put("label", label);
+        if (crash != null) j.put("crash", crash);
+        j.put("nextTimer", nextTimer());
+        if (top != null) {
+            j.key("activity").open('{');
+            top.describe(j);
+            j.close('}');
+        }
+        if (dialog != null && dialog.isShowing()) {
+            j.key("dialog").open('{');
+            dialog.describe(j);
+            j.close('}');
+        }
+        j.key("toasts").open('[');
+        for (int i = all ? 0 : toastsShown; i < toasts.size(); i++) {
+            String[] t = toasts.get(i);
+            j.item().open('{').put("text", t[0]).put("long", "1".equals(t[1])).close('}');
+        }
+        j.close(']');
+        if (consume) toastsShown = toasts.size();
+        j.key("log").open('[');
+        for (int i = all ? 0 : logShown; i < log.size(); i++) {
+            String[] e = log.get(i);
+            j.item().open('[').value(e[0]).value(e[1]).value(e[2]).value(Long.parseLong(e[3])).close(']');
+        }
+        j.close(']');
+        if (consume) logShown = log.size();
+        return j.close('}').toString();
+    }
+}
