+
+/** android.widget.EditText (stand-in): the page's phone types into it (setText, as the keyboard would). */
+public class EditText extends TextView {
+    private int inputType = 1;
+    private final SimEditable editable = new SimEditable();
+
+    public EditText(Context context) { super(context); }
+
+    @Override public Editable getText() { editable.value = String.valueOf(super.getText()); return editable; }
+
+    @Override void afterChange() {
+        editable.value = String.valueOf(super.getText());
+        for (TextWatcher w : new ArrayList<>(watchers)) w.afterTextChanged(editable);
+    }
+
+    public void setInputType(int type) { inputType = type; }
+    public int getInputType() { return inputType; }
+    public void setSelection(int index) {}
+    public void selectAll() {}
+
+    @Override public void describe(Json j) {
+        super.describe(j);
+        j.put("inputType", inputType);
+    }
+
+    @Override protected String kind() { return "EditText"; }
+
+    public final class SimEditable implements Editable {
+        String value = "";
+        public int length() { return value.length(); }
+        public char charAt(int i) { return value.charAt(i); }
+        public CharSequence subSequence(int s, int e) { return value.subSequence(s, e); }
+        public Editable append(CharSequence more) { EditText.this.append(more); return this; }
+        public void clear() { setText(""); }
+        @Override public String toString() { return value; }
+    }
+}
