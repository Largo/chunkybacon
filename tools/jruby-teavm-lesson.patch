+package android.widget;
+
+import android.content.Context;
+import android.graphics.Typeface;
+import android.text.TextWatcher;
+import android.view.Gravity;
+import android.view.View;
+import java.util.ArrayList;
+import java.util.List;
+import org.chunkybacon.sim.Json;
+
+/** android.widget.TextView (stand-in). */
+public class TextView extends View {
+    private CharSequence text = "";
+    private CharSequence hint = null;
+    private float textSize = 14f;
+    private Integer textColor = null;
+    private int gravity = Gravity.TOP | Gravity.START;
+    private Typeface typeface = null;
+    private int maxLines = 0;
+    final List<TextWatcher> watchers = new ArrayList<>();
+
+    public TextView(Context context) { super(context); }
+
+    public CharSequence getText() { return text; }
+
+    public void setText(CharSequence text) {
+        CharSequence before = this.text;
+        String next = text == null ? "" : text.toString();
+        for (TextWatcher w : new ArrayList<>(watchers)) w.beforeTextChanged(before, 0, before.length(), next.length());
+        this.text = next;
+        for (TextWatcher w : new ArrayList<>(watchers)) w.onTextChanged(next, 0, before.length(), next.length());
+        afterChange();
+    }
+
+    void afterChange() {}
+
+    public void append(CharSequence more) { setText(String.valueOf(text) + more); }
+    public int length() { return text.length(); }
+    public CharSequence getHint() { return hint; }
+    public void setHint(CharSequence hint) { this.hint = hint; }
+    public float getTextSize() { return textSize; }
+    public void setTextSize(float size) { textSize = size; }
+    public void setTextSize(int unit, float size) { textSize = size; }
+    public void setTextColor(int color) { textColor = color; }
+    public int getCurrentTextColor() { return textColor == null ? 0xDE000000 : textColor; }
+    public int getGravity() { return gravity; }
+    public void setGravity(int gravity) { this.gravity = gravity; }
+    public Typeface getTypeface() { return typeface; }
+    public void setTypeface(Typeface tf) { typeface = tf; }
+    public void setTypeface(Typeface tf, int style) { typeface = Typeface.create(tf, style); }
+    public void setMaxLines(int n) { maxLines = n; }
+    public void setSingleLine(boolean single) { maxLines = single ? 1 : 0; }
+    public void setSingleLine() { maxLines = 1; }
+    public void setLines(int n) { maxLines = n; }
+
+    public void addTextChangedListener(TextWatcher watcher) { watchers.add(watcher); }
+    public void removeTextChangedListener(TextWatcher watcher) { watchers.remove(watcher); }
+
+    @Override public void describe(Json j) {
+        super.describe(j);
+        j.put("text", String.valueOf(text)).put("textSize", (double) textSize).put("gravity", gravity);
+        if (hint != null) j.put("hint", String.valueOf(hint));
+        if (textColor != null) j.put("textColor", textColor.intValue() & 0xFFFFFFFFL);
+        if (typeface != null) {
+            j.put("font", typeface.getFamily());
+            if (typeface.isBold()) j.put("bold", true);
+            if (typeface.isItalic()) j.put("italic", true);
+        }
+        if (maxLines > 0) j.put("maxLines", maxLines);
+    }
+
+    @Override protected String kind() { return "TextView"; }
+}
