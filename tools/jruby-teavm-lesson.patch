+
+/** android.app.Dialog (stand-in): one at a time on the simulated phone. */
+public class Dialog implements DialogInterface {
+    private CharSequence title;
+    private boolean showing = false;
+    private boolean cancelable = true;
+
+    public Dialog(Context context) {}
+
+    public void setTitle(CharSequence title) { this.title = title; }
+    public CharSequence getTitle() { return title; }
+    public void setCancelable(boolean c) { cancelable = c; }
+    public boolean isCancelable() { return cancelable; }
+    public void show() { showing = true; Device.dialog = this; }
+    public boolean isShowing() { return showing; }
+    public void dismiss() { showing = false; if (Device.dialog == this) Device.dialog = null; }
+    public void cancel() { dismiss(); }
+    /** the view in the dialog (AlertDialog.Builder#setView), for the simulated finger */
+    public android.view.View simView() { return null; }
+
+    public void describe(Json j) {
+        if (title != null) j.put("title", title.toString());
+        j.put("cancelable", cancelable);
+    }
+}
