@@ -0,0 +1,73 @@
+package org.chunkybacon.sim;
+
+import android.view.Menu;
+import android.view.MenuItem;
+import java.util.ArrayList;
+import java.util.List;
+
+/** The options menu of the simulated phone's app bar. */
+public final class SimMenu implements Menu {
+    final List<Item> items = new ArrayList<>();
+    private int nextId = 0x7f0a1000;
+
+    public MenuItem add(CharSequence title) { return add(0, nextId++, 0, title); }
+
+    public MenuItem add(int groupId, int itemId, int order, CharSequence title) {
+        Item item = new Item(itemId, order, title);
+        int at = items.size();
+        while (at > 0 && items.get(at - 1).order > order) at--;
+        items.add(at, item);
+        return item;
+    }
+
+    public MenuItem findItem(int id) { for (Item i : items) if (i.id == id) return i; return null; }
+    public MenuItem getItem(int index) { return items.get(index); }
+    public int size() { return items.size(); }
+    public void clear() { items.clear(); }
+    public void removeItem(int id) { items.removeIf(i -> i.id == id); }
+
+    /** true when the item's own listener handled the click */
+    public static boolean clickListener(MenuItem item) {
+        Item i = (Item) item;
+        return i.listener != null && i.listener.onMenuItemClick(item);
+    }
+
+    void describe(Json j) {
+        j.open('[');
+        for (int n = 0; n < items.size(); n++) {
+            Item i = items.get(n);
+            if (!i.visible) continue;
+            j.item().open('{').put("index", n).put("title", String.valueOf(i.title)).put("action", i.show != 0);
+            if (!i.enabled) j.put("enabled", false);
+            if (i.checkable) j.put("checked", i.checked);
+            j.close('}');
+        }
+        j.close(']');
+    }
+
+    public static final class Item implements MenuItem {
+        final int id;
+        final int order;
+        CharSequence title;
+        OnMenuItemClickListener listener;
+        int show = SHOW_AS_ACTION_NEVER;
+        boolean enabled = true, visible = true, checkable = false, checked = false;
+
+        Item(int id, int order, CharSequence title) { this.id = id; this.order = order; this.title = title; }
+
+        public int getItemId() { return id; }
+        public CharSequence getTitle() { return title; }
+        public MenuItem setTitle(CharSequence title) { this.title = title; return this; }
+        public MenuItem setOnMenuItemClickListener(OnMenuItemClickListener l) { listener = l; return this; }
+        public void setShowAsAction(int actionEnum) { show = actionEnum; }
+        public MenuItem setEnabled(boolean e) { enabled = e; return this; }
+        public boolean isEnabled() { return enabled; }
+        public MenuItem setVisible(boolean v) { visible = v; return this; }
+        public boolean isVisible() { return visible; }
+        public MenuItem setCheckable(boolean c) { checkable = c; return this; }
+        public MenuItem setChecked(boolean c) { checked = c; return this; }
+        public boolean isChecked() { return checked; }
+        public MenuItem setIcon(int iconRes) { return this; }
+        @Override public String toString() { return String.valueOf(title); }
+    }
+}
diff --git a/android-src/org/chunkybacon/sim/SimPreferences.java b/android-src/org/chunkybacon/sim/SimPreferences.java
new file mode 100644
index 0000000..4fee8b0
--- /dev/null
+++ b/android-src/org/chunkybacon/sim/SimPreferences.java
@@ -0,0 +1,44 @@
+package org.chunkybacon.sim;
+
+import android.content.SharedPreferences;
+import java.util.HashMap;
+import java.util.Map;
+
+/** SharedPreferences of the simulated phone: kept while the page is open (the app's data). */
+public final class SimPreferences implements SharedPreferences {
+    final Map<String, Object> values = new HashMap<>();
+
+    public String getString(String key, String defValue) { Object v = values.get(key); return v instanceof String ? (String) v : defValue; }
+    public int getInt(String key, int defValue) { Object v = values.get(key); return v instanceof Integer ? (Integer) v : defValue; }
+    public long getLong(String key, long defValue) { Object v = values.get(key); return v instanceof Long ? (Long) v : defValue; }
+    public float getFloat(String key, float defValue) { Object v = values.get(key); return v instanceof Float ? (Float) v : defValue; }
+    public boolean getBoolean(String key, boolean defValue) { Object v = values.get(key); return v instanceof Boolean ? (Boolean) v : defValue; }
+    public boolean contains(String key) { return values.containsKey(key); }
+    public Map<String, ?> getAll() { return new HashMap<>(values); }
+    public SharedPreferences.Editor edit() { return new SimEditor(this); }
+
+    public static final class SimEditor implements SharedPreferences.Editor {
+        private final SimPreferences prefs;
+        private final Map<String, Object> changes = new HashMap<>();
+        private boolean clear = false;
+        SimEditor(SimPreferences prefs) { this.prefs = prefs; }
+        public SharedPreferences.Editor putString(String key, String value) { changes.put(key, value); return this; }
+        public SharedPreferences.Editor putInt(String key, int value) { changes.put(key, value); return this; }
+        public SharedPreferences.Editor putLong(String key, long value) { changes.put(key, value); return this; }
+        public SharedPreferences.Editor putFloat(String key, float value) { changes.put(key, value); return this; }
+        public SharedPreferences.Editor putBoolean(String key, boolean value) { changes.put(key, value); return this; }
+        public SharedPreferences.Editor remove(String key) { changes.put(key, this); return this; }
+        public SharedPreferences.Editor clear() { clear = true; return this; }
+        public boolean commit() {
+            if (clear) prefs.values.clear();
+            for (Map.Entry<String, Object> e : changes.entrySet()) {
+                if (e.getValue() == this || e.getValue() == null) prefs.values.remove(e.getKey());
+                else prefs.values.put(e.getKey(), e.getValue());
+            }
+            changes.clear();
+            clear = false;
+            return true;
+        }
+        public void apply() { commit(); }
+    }
+}
