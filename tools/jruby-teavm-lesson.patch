+++ b/demo-src/lesson/Quakes.java
@@ -0,0 +1,27 @@
+package lesson;
+
+import com.fasterxml.jackson.core.JsonFactory;
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.core.JsonToken;
+import java.io.IOException;
+
+/**
+ * Chunky Bacon's JRuby lesson: the Jackson streaming loop of the lesson's Ruby cell, written in Java, so that
+ * Ruby calls Java once instead of once per token. The lesson shows this method as it is.
+ */
+public final class Quakes {
+    private Quakes() {}
+
+    /** How many earthquakes of a USGS GeoJSON feed have a magnitude ("mag") of at least min. */
+    public static int countAtLeast(String json, double min) throws IOException {
+        int n = 0;
+        JsonParser p = new JsonFactory().createParser(json);
+        JsonToken t;
+        while ((t = p.nextToken()) != null) {
+            if (t == JsonToken.FIELD_NAME && "mag".equals(p.currentName())) {
+                if (p.nextToken().isNumeric() && p.getDoubleValue() >= min) n++;
+            }
+        }
+        return n;
+    }
+}
