+package android.view;
+
+import android.content.Context;
+import org.chunkybacon.sim.Device;
+import org.chunkybacon.sim.Json;
+
+/**
+ * android.view.View (stand-in, chunkybacon Ruboto lesson). Draws nothing:
+ * describe() writes what the page's phone draws. Sizes are dp (the
+ * simulated phone has a density of 1).
+ */
+public class View {
+    public static final int VISIBLE = 0;
+    public static final int INVISIBLE = 4;
+    public static final int GONE = 8;
+    public static final int NO_ID = -1;
+    public static final int TEXT_ALIGNMENT_INHERIT = 0;
+    public static final int TEXT_ALIGNMENT_GRAVITY = 1;
+    public static final int TEXT_ALIGNMENT_TEXT_START = 2;
+    public static final int TEXT_ALIGNMENT_TEXT_END = 3;
+    public static final int TEXT_ALIGNMENT_CENTER = 4;
+    public static final int TEXT_ALIGNMENT_VIEW_START = 5;
+    public static final int TEXT_ALIGNMENT_VIEW_END = 6;
+
+    public interface OnClickListener { void onClick(View v); }
+    public interface OnLongClickListener { boolean onLongClick(View v); }
+
+    private final Context context;
+    private final int simId;
+    private int id = NO_ID;
+    private int visibility = VISIBLE;
+    private boolean enabled = true;
+    private boolean clickable = false;
+    private int[] padding = { 0, 0, 0, 0 };
+    private Integer background = null;
+    private float alpha = 1f;
+    private int textAlignment = TEXT_ALIGNMENT_GRAVITY;
+    private ViewGroup.LayoutParams layoutParams;
+    ViewGroup parent;
+    private Object tag;
+    private OnClickListener onClick;
+    private OnLongClickListener onLongClick;
+    private int minimumHeight = 0, minimumWidth = 0;
+
+    public View(Context context) {
+        this.context = context;
+        this.simId = Device.register(this);
+    }
+
+    public Context getContext() { return context; }
+    public int getSimId() { return simId; }
+
+    public int getId() { return id; }
+    public void setId(int id) { this.id = id; }
+    public int getVisibility() { return visibility; }
+    public void setVisibility(int v) { this.visibility = v; }
+    public boolean isShown() { return visibility == VISIBLE && (parent == null || parent.isShown()); }
+    public boolean isEnabled() { return enabled; }
+    public void setEnabled(boolean enabled) { this.enabled = enabled; }
+    public boolean isClickable() { return clickable; }
+    public void setClickable(boolean clickable) { this.clickable = clickable; }
+    public void setPadding(int left, int top, int right, int bottom) { padding = new int[] { left, top, right, bottom }; }
+    public int getPaddingLeft() { return padding[0]; }
+    public int getPaddingTop() { return padding[1]; }
+    public int getPaddingRight() { return padding[2]; }
+    public int getPaddingBottom() { return padding[3]; }
+    public void setBackgroundColor(int color) { background = color; }
+    public float getAlpha() { return alpha; }
+    public void setAlpha(float alpha) { this.alpha = alpha; }
+    public int getTextAlignment() { return textAlignment; }
+    public void setTextAlignment(int a) { textAlignment = a; }
+    public void setMinimumHeight(int h) { minimumHeight = h; }
+    public void setMinimumWidth(int w) { minimumWidth = w; }
+    public Object getTag() { return tag; }
+    public void setTag(Object tag) { this.tag = tag; }
+    public ViewParent getParent() { return parent; }
+
+    public ViewGroup.LayoutParams getLayoutParams() { return layoutParams; }
+    public void setLayoutParams(ViewGroup.LayoutParams params) { this.layoutParams = params; }
+
+    public void setOnClickListener(OnClickListener l) { if (l != null) clickable = true; onClick = l; }
+    public void setOnLongClickListener(OnLongClickListener l) { onLongClick = l; }
+    public boolean hasOnClickListeners() { return onClick != null; }
+
+    public boolean performClick() {
+        if (onClick == null) return false;
+        onClick.onClick(this);
+        return true;
+    }
+
+    public boolean performLongClick() { return onLongClick != null && onLongClick.onLongClick(this); }
+
+    public void invalidate() {}
+    public void requestLayout() {}
+    public boolean requestFocus() { return true; }
+
+    public View findViewById(int id) { return this.id == id ? this : null; }
+
+    /** what the page draws; subclasses add theirs after super's */
+    public void describe(Json j) {
+        j.put("type", kind()).put("sim", simId);
+        if (id != NO_ID) j.put("id", id);
+        if (visibility != VISIBLE) j.put("visibility", visibility == GONE ? "gone" : "invisible");
+        if (!enabled) j.put("enabled", false);
+        if (onClick != null || clickable) j.put("clickable", true);
+        if (onLongClick != null) j.put("longClickable", true);
+        if (padding[0] != 0 || padding[1] != 0 || padding[2] != 0 || padding[3] != 0) {
+            j.key("padding").open('[').value(padding[0]).value(padding[1]).value(padding[2]).value(padding[3]).close(']');
+        }
+        if (background != null) j.put("background", background.intValue() & 0xFFFFFFFFL);
+        if (alpha != 1f) j.put("alpha", (double) alpha);
+        if (textAlignment != TEXT_ALIGNMENT_GRAVITY) j.put("textAlignment", textAlignment);
+        if (minimumHeight > 0) j.put("minHeight", minimumHeight);
+        if (minimumWidth > 0) j.put("minWidth", minimumWidth);
+        if (layoutParams != null) { j.key("layout").open('{'); layoutParams.describe(j); j.close('}'); }
+    }
+
+    /** the class name the page draws by: the nearest stand-in's */
+    protected String kind() { return "View"; }
+
+    @Override public String toString() {
+        return getClass().getName() + "{" + Integer.toHexString(System.identityHashCode(this)) + (id != NO_ID ? " #" + id : "") + "}";
+    }
+}
diff --git a/android-src/android/view/ViewGroup.java b/android-src/android/view/ViewGroup.java
new file mode 100644
index 0000000..c0fa44b
--- /dev/null
+++ b/android-src/android/view/ViewGroup.java
@@ -0,0 +1,91 @@
+package android.view;
+
+import android.content.Context;
+import java.util.ArrayList;
+import java.util.List;
+import org.chunkybacon.sim.Json;
+
+/** android.view.ViewGroup (stand-in): a view with children. */
+public abstract class ViewGroup extends View implements ViewParent {
+    private final List<View> children = new ArrayList<>();
+
+    public ViewGroup(Context context) { super(context); }
+
+    public static class LayoutParams {
+        public static final int FILL_PARENT = -1;
+        public static final int MATCH_PARENT = -1;
+        public static final int WRAP_CONTENT = -2;
+
+        public int width;
+        public int height;
+
+        public LayoutParams(int width, int height) { this.width = width; this.height = height; }
+        public LayoutParams(LayoutParams source) { this(source.width, source.height); }
+
+        public void describe(Json j) { j.put("width", width).put("height", height); }
+    }
+
+    public static class MarginLayoutParams extends LayoutParams {
+        public int leftMargin, topMargin, rightMargin, bottomMargin;
+
+        public MarginLayoutParams(int width, int height) { super(width, height); }
+        public MarginLayoutParams(LayoutParams source) { super(source); }
+
+        public void setMargins(int left, int top, int right, int bottom) {
+            leftMargin = left; topMargin = top; rightMargin = right; bottomMargin = bottom;
+        }
+
+        @Override public void describe(Json j) {
+            super.describe(j);
+            if (leftMargin != 0 || topMargin != 0 || rightMargin != 0 || bottomMargin != 0) {
+                j.key("margins").open('[').value(leftMargin).value(topMargin).value(rightMargin).value(bottomMargin).close(']');
+            }
+        }
+    }
+
+    protected LayoutParams generateDefaultLayoutParams() {
+        return new MarginLayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT);
+    }
+
+    public void addView(View child) { addView(child, -1); }
+
+    public void addView(View child, int index) {
+        if (child.parent != null) {
+            throw new IllegalStateException("The specified child already has a parent. You must call removeView() on the child's parent first.");
+        }
+        if (child.getLayoutParams() == null) child.setLayoutParams(generateDefaultLayoutParams());
+        if (index < 0 || index > children.size()) children.add(child); else children.add(index, child);
+        child.parent = this;
+    }
+
+    public void addView(View child, LayoutParams params) {
+        child.setLayoutParams(params);
+        addView(child, -1);
+    }
+
+    public void removeView(View child) { if (children.remove(child)) child.parent = null; }
+    public void removeViewAt(int index) { removeView(children.get(index)); }
+    public void removeAllViews() { for (View c : children) c.parent = null; children.clear(); }
+    public int getChildCount() { return children.size(); }
+    public View getChildAt(int index) { return index >= 0 && index < children.size() ? children.get(index) : null; }
+    public int indexOfChild(View child) { return children.indexOf(child); }
+
+    @Override public View findViewById(int id) {
+        View self = super.findViewById(id);
+        if (self != null) return self;
+        for (View c : children) {
+            View found = c.findViewById(id);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    @Override public void describe(Json j) {
+        super.describe(j);
+        j.key("children").open('[');
+        for (View c : children) { j.item().open('{'); c.describe(j); j.close('}'); }
+        j.close(']');
+    }
+
+    @Override protected String kind() { return "ViewGroup"; }
+}
