+package android.widget;
+
+import android.content.Context;
+
+/** android.widget.SeekBar (stand-in): the page's phone drags it with simDrag. */
+public class SeekBar extends ProgressBar {
+    public interface OnSeekBarChangeListener {
+        void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser);
+        void onStartTrackingTouch(SeekBar seekBar);
+        void onStopTrackingTouch(SeekBar seekBar);
+    }
+
+    private OnSeekBarChangeListener listener;
+    private boolean fromUser = false;
+
+    public SeekBar(Context context) { super(context); }
+
+    public void setOnSeekBarChangeListener(OnSeekBarChangeListener l) { listener = l; }
+
+    @Override void progressChanged(boolean ignored) {
+        if (listener != null) listener.onProgressChanged(this, getProgress(), fromUser);
+    }
+
+    /** the simulated finger: touch, move to +progress+, let go */
+    public void simDrag(int progress) {
+        if (listener != null) listener.onStartTrackingTouch(this);
+        fromUser = true;
+        try { setProgress(progress); } finally { fromUser = false; }
+        if (listener != null) listener.onStopTrackingTouch(this);
+    }
+
+    @Override protected String kind() { return "SeekBar"; }
+}
