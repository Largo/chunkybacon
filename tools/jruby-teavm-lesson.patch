+package android.widget;
+
+import android.content.Context;
+import org.chunkybacon.sim.Json;
+
+/** android.widget.CompoundButton (stand-in): a button that is checked or not. */
+public abstract class CompoundButton extends Button {
+    public interface OnCheckedChangeListener { void onCheckedChanged(CompoundButton button, boolean isChecked); }
+
+    private boolean checked;
+    private OnCheckedChangeListener listener;
+
+    public CompoundButton(Context context) { super(context); setGravity(android.view.Gravity.START | android.view.Gravity.CENTER_VERTICAL); }
+
+    public boolean isChecked() { return checked; }
+    public void setChecked(boolean c) {
+        if (c == checked) return;
+        checked = c;
+        if (listener != null) listener.onCheckedChanged(this, c);
+    }
+    public void toggle() { setChecked(!checked); }
+    public void setOnCheckedChangeListener(OnCheckedChangeListener l) { listener = l; }
+
+    @Override public boolean performClick() {
+        toggle();
+        super.performClick();
+        return true;
+    }
+
+    @Override public void describe(Json j) {
+        super.describe(j);
+        j.put("checked", checked).put("clickable", true);
+    }
+}
