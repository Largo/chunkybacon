diff --git a/android-src/org/chunkybacon/sim/Json.java b/android-src/org/chunkybacon/sim/Json.java
new file mode 100644
index 0000000..e9d4bab
--- /dev/null
+++ b/android-src/org/chunkybacon/sim/Json.java
@@ -0,0 +1,45 @@
+package org.chunkybacon.sim;
+
+/** A small JSON writer for the phone's snapshot (no reflection, no library). */
+public final class Json {
+    private final StringBuilder out = new StringBuilder();
+    private boolean first = true;
+
+    public Json open(char brace) { out.append(brace); first = true; return this; }
+    public Json close(char brace) { out.append(brace); first = false; return this; }
+
+    private void comma() { if (!first) out.append(','); first = false; }
+
+    public Json key(String name) { comma(); str(name); out.append(':'); first = true; return this; }
+    public Json item() { comma(); first = true; return this; }
+
+    public Json value(String s) { comma(); if (s == null) out.append("null"); else str(s); return this; }
+    public Json value(long n) { comma(); out.append(n); return this; }
+    public Json value(double n) { comma(); out.append(Double.isFinite(n) ? Double.toString(n) : "0"); return this; }
+    public Json value(boolean b) { comma(); out.append(b); return this; }
+
+    public Json put(String k, String v) { return key(k).value(v); }
+    public Json put(String k, long v) { return key(k).value(v); }
+    public Json put(String k, double v) { return key(k).value(v); }
+    public Json put(String k, boolean v) { return key(k).value(v); }
+
+    private void str(String s) {
+        out.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '"': out.append("\\\""); break;
+                case '\\': out.append("\\\\"); break;
+                case '\n': out.append("\\n"); break;
+                case '\r': out.append("\\r"); break;
+                case '\t': out.append("\\t"); break;
+                default:
+                    if (c < 0x20) out.append(String.format("\\u%04x", (int) c));
+                    else out.append(c);
+            }
+        }
+        out.append('"');
+    }
+
+    @Override public String toString() { return out.toString(); }
+}
diff --git a/android-src/org/chunkybacon/sim/SimMenu.java b/android-src/org/chunkybacon/sim/SimMenu.java
