+public class Spinner extends AdapterView<SpinnerAdapter> {
+    private SpinnerAdapter adapter;
+
+    public Spinner(Context context) { super(context); }
+
+    public SpinnerAdapter getAdapter() { return adapter; }
+    public void setAdapter(SpinnerAdapter adapter) {
+        this.adapter = adapter;
+        selected = adapter != null && adapter.getCount() > 0 ? 0 : INVALID_POSITION;
+    }
+
+    /** Android reports the first selection after the layout pass; the simulated phone does it when the app has drawn */
+    public void simInitialSelection() {
+        if (selected != INVALID_POSITION && getOnItemSelectedListener() != null) {
+            getOnItemSelectedListener().onItemSelected(this, row(selected), selected, getItemIdAtPosition(selected));
+        }
+    }
+
+    @Override protected String kind() { return "Spinner"; }
+}
